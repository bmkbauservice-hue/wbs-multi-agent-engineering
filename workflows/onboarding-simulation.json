      "id": "aea020f2-2a84-415a-ac9a-20c215fa5ff4",
      "name": "Abteilung_lesen",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.2,
      "position": [
        240,
        720
      ],
      "parameters": {
        "description": "Fiktive Abteilung nachschlagen. Eingabe: nur Marketing, IT oder Personal als String.",
        "language": "javaScript",
        "specifyInputSchema": false,
        "jsCode": "const db = {marketing:{teamLead:'Alex Beispiel',accounts:['E-Mail','Slack','Canva']},it:{teamLead:'Kim Muster',accounts:['E-Mail','Slack','GitHub','VPN']},personal:{teamLead:'Sam Demo',accounts:['E-Mail','Slack','HR-Testsystem']}};\nconst key=String(query).trim().toLowerCase();\nreturn JSON.stringify(Object.hasOwn(db,key)?{status:'gefunden',quelle:'FIKTIVE_TESTDATEN',department:key,...db[key]}:{status:'nicht_gefunden',quelle:'FIKTIVE_TESTDATEN'});"
      }
    },
    {
      "id": "8b6ff04a-7e6c-4933-89fe-496083753596",
      "name": "Begruessung_Vorschau",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.2,
      "position": [
        800,
        720
      ],
      "parameters": {
        "description": "Simuliert Slack ohne Versand. Eingabe: fertiger Begrüßungstext.",
        "language": "javaScript",
        "specifyInputSchema": false,
        "jsCode": "const message=String(query).trim();\nif (!message || message.length>1000 || /@[^\\s]+\\.[a-z]{2,}/i.test(message)) return JSON.stringify({status:'ungueltig',sent:false});\nreturn JSON.stringify({status:'VORSCHAU',sent:false,message});"
      }
    }
